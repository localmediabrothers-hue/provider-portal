# Copy this file to .env.local and fill in your real Supabase project values.
# Get these from your Supabase project's Settings -> API page.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# These are NOT read by the frontend — they belong to the approve-enquiry Edge
# Function and are set separately with:
#   supabase secrets set JOTFORM_FORM_ID=... JOTFORM_API_KEY=... \
#     RESEND_API_KEY=... TWILIO_ACCOUNT_SID=... TWILIO_AUTH_TOKEN=... \
#     TWILIO_FROM_NUMBER=...
# Listed here only so you know what to gather before going live.
